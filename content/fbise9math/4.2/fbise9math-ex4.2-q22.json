{
  "title": "Exercise 4.2 — Question 22",
  "type": "PLAYER",
  "body": {
    "version": "deck-v2",
    "name": "Exercise 4.2 — Question 22",
    "audio": "music.mp3",
    "theme": "blue",
    "background": {
      "backgroundColor": "#010214",
      "backgroundImage": "banner.webp",
      "backgroundImageOpacity": 0.09
    },
    "deck": [
      {
        "type": "eq",
        "start": 0,
        "end": 70,
        "data": [
          {
            "name": "line",
            "type": "heading",
            "content": "Exercise 4.2 — Question 22",
            "showAt": 0,
            "spItems": [
              {
                "type": "text",
                "content": "Express the given expression as the product of three factors."
              },
              {
                "type": "text",
                "content": "Then decide whether each factor is a binomial or trinomial."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "8+12t+6t^2+t^3",
            "showAt": 10,
            "spItems": [
              {
                "type": "text",
                "content": "Arrange the terms in descending powers of t."
              },
              {
                "type": "text",
                "content": "Compare the expression with the cube expansion."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "t^3+6t^2+12t+8",
            "showAt": 20,
            "spItems": [
              {
                "type": "text",
                "content": "This matches a³+3a²b+3ab²+b³."
              },
              {
                "type": "text",
                "content": "Take a=t and b=2."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(t+2)^3",
            "showAt": 30,
            "spItems": [
              {
                "type": "text",
                "content": "Apply the perfect cube identity."
              },
              {
                "type": "text",
                "content": "The whole expression is one cube."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(t+2)(t+2)(t+2)",
            "showAt": 40,
            "spItems": [
              {
                "type": "text",
                "content": "Write the cube as three identical factors."
              },
              {
                "type": "text",
                "content": "Now there are exactly three factors."
              }
            ]
          },
          {
            "name": "line",
            "type": "heading",
            "content": "Type of each factor",
            "showAt": 50,
            "spItems": [
              {
                "type": "text",
                "content": "Each factor is t+2."
              },
              {
                "type": "text",
                "content": "A factor with two terms is a binomial."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(t+2)(t+2)(t+2)",
            "showAt": 60,
            "spItems": [
              {
                "type": "text",
                "content": "All three factors are binomials."
              },
              {
                "type": "text",
                "content": "No trinomial factor occurs."
              }
            ]
          }
        ]
      }
    ]
  }
}