            "showAt": 0,
            "spItems": [
              {
                "type": "text",
                "content": "Factorize the following expression completely."
              },
              {
                "type": "text",
                "content": "Look for the expansion of a perfect cube."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "8p^3+q^3+12p^2q+6pq^2",
            "showAt": 10,
            "spItems": [
              {
                "type": "text",
                "content": "Recognize 8p³=(2p)³ and q³=q³."
              },
              {
                "type": "text",
                "content": "Compare the middle terms with the cube formula."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(2p)^3+3(2p)^2q+3(2p)q^2+q^3",
            "showAt": 20,
            "spItems": [
              {
                "type": "text",
                "content": "The middle terms are 12p²q and 6pq²."
              },
              {
                "type": "text",
                "content": "This matches a³+3a²b+3ab²+b³."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(2p+q)^3",
            "showAt": 30,
            "spItems": [
              {
                "type": "text",
                "content": "Take a=2p and b=q."
              },
              {
                "type": "text",
                "content": "The whole expression is one perfect cube."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(2p+q)(2p+q)(2p+q)",
            "showAt": 40,
            "spItems": [
              {
                "type": "text",
                "content": "Write the cube as three identical factors."
              },
              {
                "type": "text",
                "content": "This is the complete factorization."
              }
            ]
          }
        ]
      }
