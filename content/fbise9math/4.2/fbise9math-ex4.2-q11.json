            "showAt": 10,
            "spItems": [
              {
                "type": "text",
                "content": "Recognize 125x³=(5x)³ and y³=y³."
              },
              {
                "type": "text",
                "content": "Compare the middle terms with the cube formula."
              }
            ]
          },
          {
            "name": "line",
