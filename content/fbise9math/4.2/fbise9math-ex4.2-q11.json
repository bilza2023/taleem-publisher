            "spItems": [
              {
                "type": "text",
                "content": "The terms match a³−3a²b+3ab²−b³."
              },
              {
                "type": "text",
                "content": "Take a=5x and b=y."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(5x-y)^3",
            "showAt": 30,
            "spItems": [
              {
                "type": "text",
                "content": "Apply the perfect-cube identity."
              },
              {
                "type": "text",
                "content": "All four terms combine into one cube."
              }
            ]
