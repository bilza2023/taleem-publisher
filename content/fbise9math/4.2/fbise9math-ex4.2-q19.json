      "backgroundImageOpacity": 0.09
    },
    "deck": [
      {
        "type": "eq",
        "start": 0,
        "end": 80,
        "data": [
          {
            "name": "line",
            "type": "heading",
            "content": "Exercise 4.2 — Question 19",
            "showAt": 0,
            "spItems": [
              {
                "type": "text",
                "content": "Factorize the following expression completely."
              },
              {
                "type": "text",
                "content": "Look for a common expression after pairing the factors."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(x-2)(x-6)(x-3)(x-4)-2x^2",
            "showAt": 10,
            "spItems": [
              {
                "type": "text",
                "content": "Pair (x−2)(x−6) and (x−3)(x−4)."
              },
              {
                "type": "text",
                "content": "Both products contain x² and a constant 12."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(x^2-8x+12)(x^2-7x+12)-2x^2",
            "showAt": 20,
            "spItems": [
              {
                "type": "text",
                "content": "Expand each pair."
              },
              {
                "type": "text",
                "content": "Let A=x²+12."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(A-8x)(A-7x)-2x^2",
            "showAt": 30,
            "spItems": [
              {
                "type": "text",
                "content": "Replace x²+12 by A."
              },
              {
                "type": "text",
                "content": "Now expand the product in terms of A."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "A^2-15Ax+56x^2-2x^2",
            "showAt": 40,
            "spItems": [
              {
                "type": "text",
                "content": "Multiply the two brackets."
              },
              {
                "type": "text",
                "content": "Combine 56x²−2x² to get 54x²."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "A^2-15Ax+54x^2",
            "showAt": 50,
            "spItems": [
              {
                "type": "text",
                "content": "Find two factors of 54 whose sum is 15."
              },
              {
                "type": "text",
                "content": "The required numbers are 6 and 9."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(A-6x)(A-9x)",
            "showAt": 60,
            "spItems": [
              {
                "type": "text",
                "content": "Factor the quadratic in A."
              },
              {
                "type": "text",
                "content": "Now substitute A=x²+12."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(x^2-6x+12)(x^2-9x+12)",
            "showAt": 70,
            "spItems": [
              {
                "type": "text",
                "content": "Replace A in both factors."
              },
              {
                "type": "text",
                "content": "This is the complete factorization."
              }
            ]
          }
        ]
      }
    ]
  }
