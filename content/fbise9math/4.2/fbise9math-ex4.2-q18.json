      "backgroundImageOpacity": 0.09
    },
    "deck": [
      {
        "type": "eq",
        "start": 0,
        "end": 80,
        "data": [
          {
            "name": "line",
            "type": "heading",
            "content": "Exercise 4.2 — Question 18",
            "showAt": 0,
            "spItems": [
              {
                "type": "text",
                "content": "Factorize the following expression completely."
              },
              {
                "type": "text",
                "content": "Look for a difference of two squares."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(x+1)(x+2)(x-3)(x-6)-21x^2",
            "showAt": 10,
            "spItems": [
              {
                "type": "text",
                "content": "Group the four factors strategically."
              },
              {
                "type": "text",
                "content": "The goal is to create two expressions differing by 5x."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(x^2-3x-6)^2-25x^2",
            "showAt": 20,
            "spItems": [
              {
                "type": "text",
                "content": "Rewrite the product and combine the -21x² term."
              },
              {
                "type": "text",
                "content": "Now the expression is a difference of two squares."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(x^2-3x-6)^2-(5x)^2",
            "showAt": 30,
            "spItems": [
              {
                "type": "text",
                "content": "Recognize 25x² as (5x)²."
              },
              {
                "type": "text",
                "content": "Apply A²−B²=(A−B)(A+B)."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(x^2-8x-6)(x^2+2x-6)",
            "showAt": 40,
            "spItems": [
              {
                "type": "text",
                "content": "Subtract 5x from x²−3x−6 for the first factor."
              },
              {
                "type": "text",
                "content": "Add 5x to x²−3x−6 for the second factor."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(x^2-8x-6)(x^2+2x-6)",
            "showAt": 50,
            "spItems": [
              {
                "type": "text",
                "content": "The two factors are obtained from the difference of squares."
              },
              {
                "type": "text",
                "content": "This is the complete factorization."
              }
            ]
          }
        ]
      }
    ]
  }
