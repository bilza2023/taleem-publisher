        "data": [
          {
            "name": "line",
            "type": "heading",
            "content": "Exercise 4.3 — Question 6",
            "showAt": 0,
            "spItems": [
              {
                "type": "text",
                "content": "Find the HCF of the following by factorization."
              },
              {
                "type": "text",
                "content": "Factorize both quadratics and identify their common factor."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "12x^2+x-1, 15x^2+8x+1",
            "showAt": 10,
            "spItems": [
              {
                "type": "text",
                "content": "Factorize the first quadratic."
              },
              {
                "type": "text",
                "content": "Find two factors of -12 whose sum is 1."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "12x^2+4x-3x-1",
            "showAt": 20,
            "spItems": [
              {
                "type": "text",
                "content": "Split x into 4x−3x."
              },
              {
                "type": "text",
                "content": "Group the terms."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(4x-1)(3x+1)",
            "showAt": 30,
            "spItems": [
              {
                "type": "text",
                "content": "Factor each group."
              },
              {
                "type": "text",
                "content": "Now factorize the second quadratic."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "15x^2+3x+5x+1",
            "showAt": 40,
            "spItems": [
              {
                "type": "text",
                "content": "Split 8x into 3x+5x."
              },
              {
                "type": "text",
                "content": "Group the terms."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(3x+1)(5x+1)",
            "showAt": 50,
            "spItems": [
              {
                "type": "text",
                "content": "Factor each group."
              },
              {
                "type": "text",
                "content": "Both expressions contain the factor 3x+1."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "HCF=3x+1",
            "showAt": 60,
            "spItems": [
              {
                "type": "text",
                "content": "Take the common factor with the least power."
              },
              {
                "type": "text",
                "content": "Therefore the HCF is 3x+1."
              }
            ]
          }
        ]
      }
