          {
            "name": "line",
            "type": "heading",
            "content": "Exercise 4.3 — Question 5",
            "showAt": 0,
            "spItems": [
              {
                "type": "text",
                "content": "Find the HCF of the following by factorization."
              },
              {
                "type": "text",
                "content": "Factorize both expressions and identify their common factor."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "x^2-49, x^2-4x-21",
            "showAt": 10,
            "spItems": [
              {
                "type": "text",
                "content": "The first expression is a difference of two squares."
              },
              {
                "type": "text",
                "content": "Factor the second quadratic by finding factors of −21 with sum −4."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(x-7)(x+7), (x-7)(x+3)",
            "showAt": 20,
            "spItems": [
              {
                "type": "text",
                "content": "Use x²−49=(x−7)(x+7)."
              },
              {
                "type": "text",
                "content": "For x²−4x−21, the factors are x−7 and x+3."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(x-7)(x+7), (x-7)(x+3)",
            "showAt": 30,
            "spItems": [
              {
                "type": "text",
                "content": "Compare the factors of both expressions."
              },
              {
                "type": "text",
                "content": "The common factor is x−7."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "HCF=x-7",
            "showAt": 40,
            "spItems": [
              {
                "type": "text",
                "content": "Take the common factor with the least power."
              },
              {
                "type": "text",
                "content": "Therefore the HCF is x−7."
              }
            ]
          }
        ]
      }
    ]
  }
