            "name": "line",
            "type": "math",
            "content": "2xy(xy^2-3xy+y^2)",
            "showAt": 20,
            "spItems": [
              {
                "type": "text",
                "content": "Divide each term by 2xy and write the remaining terms in the bracket."
              }
            ]
