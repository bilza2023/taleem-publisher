            "name": "line",
            "type": "math",
            "content": "2xy(y^2+xy^2-3xy)",
            "showAt": 30,
            "spItems": [
              {
                "type": "text",
                "content": "Rearrange the terms inside the bracket if needed."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "2xy(xy^2-3xy+y^2)",
            "showAt": 40,
            "spItems": [
              {
                "type": "text",
                "content": "The bracket has no further common factor, so the expression is completely factorized."
