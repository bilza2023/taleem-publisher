            "type": "heading",
            "content": "Exercise 4.1 — Question 27",
            "showAt": 0,
            "spItems": [
              {
                "type": "text",
                "content": "Factorize the following expression."
              },
              {
                "type": "text",
                "content": "First take the common factor 2."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "2a^2-4a-6",
            "showAt": 10,
            "spItems": [
              {
                "type": "text",
                "content": "All three terms are divisible by 2."
              },
              {
                "type": "text",
                "content": "Take 2 outside the bracket."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "2(a^2-2a-3)",
            "showAt": 20,
            "spItems": [
              {
                "type": "text",
                "content": "Divide each term by 2."
              },
              {
                "type": "text",
                "content": "Now factorize the quadratic inside the bracket."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "2(a^2-3a+a-3)",
            "showAt": 30,
            "spItems": [
              {
                "type": "text",
                "content": "Find two numbers whose product is -3."
              },
              {
                "type": "text",
                "content": "Their sum must be -2."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "2(a(a-3)+(a-3))",
            "showAt": 40,
            "spItems": [
              {
                "type": "text",
                "content": "Group the first two and last two terms."
              },
              {
                "type": "text",
                "content": "Take (a-3) as the common factor."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "2(a-3)(a+1)",
            "showAt": 50,
            "spItems": [
              {
                "type": "text",
                "content": "Factor out the common bracket (a-3)."
              },
              {
                "type": "text",
                "content": "This is the complete factorization."
              }
            ]
          }
        ]
      }
    ]
