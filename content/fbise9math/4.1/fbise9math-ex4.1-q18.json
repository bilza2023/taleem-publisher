          {
            "name": "line",
            "type": "heading",
            "content": "Exercise 4.1 — Question 18",
            "showAt": 0,
            "spItems": [
              {
                "type": "text",
                "content": "Factorize the following expression."
              },
              {
                "type": "text",
                "content": "Find two numbers whose product is 8 and sum is −9."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "x^2-9x+8",
            "showAt": 10,
            "spItems": [
              {
                "type": "text",
                "content": "The quadratic has leading coefficient 1."
              },
              {
                "type": "text",
                "content": "Look for factors of 8 that add to −9."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "x^2-x-8x+8",
            "showAt": 20,
            "spItems": [
              {
                "type": "text",
                "content": "The required numbers are −1 and −8."
              },
              {
                "type": "text",
                "content": "Split −9x into −x−8x."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "x(x-1)-8(x-1)",
            "showAt": 30,
            "spItems": [
              {
                "type": "text",
                "content": "Group the first two and last two terms."
              },
              {
                "type": "text",
                "content": "Take x from the first group and −8 from the second."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(x-1)(x-8)",
            "showAt": 40,
            "spItems": [
              {
                "type": "text",
                "content": "Take the common factor (x−1)."
              },
              {
                "type": "text",
                "content": "This is the complete factorization."
              }
            ]
          }
        ]
      }
    ]
