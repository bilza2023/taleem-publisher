            "showAt": 10,
            "spItems": [
              {
                "type": "text",
                "content": "Multiply -5 by 6 to get -30."
              },
              {
                "type": "text",
                "content": "Find factors of -30 whose sum is -7."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "-5x^2+3x-10x+6",
            "showAt": 20,
            "spItems": [
              {
                "type": "text",
                "content": "Use 3 and -10 because their sum is -7."
              },
              {
                "type": "text",
                "content": "Split the middle term -7x."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "-x(5x-3)-2(5x-3)",
            "showAt": 30,
            "spItems": [
              {
                "type": "text",
                "content": "Group the first two and last two terms."
              },
              {
                "type": "text",
                "content": "Factor -x from the first group and -2 from the second."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(-x-2)(5x-3)",
            "showAt": 40,
            "spItems": [
              {
                "type": "text",
                "content": "Take the common factor (5x-3)."
              },
              {
                "type": "text",
                "content": "The remaining factor is -x-2."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(3-5x)(x+2)",
            "showAt": 50,
            "spItems": [
              {
                "type": "text",
                "content": "Rewrite (-x-2) as -(x+2)."
              },
              {
                "type": "text",
                "content": "Combine the negative sign with (5x-3)."
              }
