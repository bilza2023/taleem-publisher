            "spItems": [
              {
                "type": "text",
                "content": "Factorize the following expression."
              },
              {
                "type": "text",
                "content": "Use the middle-term splitting method."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "-3y^2+13y-4",
            "showAt": 10,
            "spItems": [
              {
                "type": "text",
                "content": "Multiply the first and last coefficients: (−3)(−4)=12."
              },
              {
                "type": "text",
                "content": "Find factors of 12 whose sum is 13."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "-3y^2+12y+y-4",
            "showAt": 20,
            "spItems": [
              {
                "type": "text",
                "content": "Use 12 and 1 because 12+1=13."
              },
              {
                "type": "text",
                "content": "Split the middle term 13y."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "-3y(y-4)+(y-4)",
            "showAt": 30,
            "spItems": [
              {
                "type": "text",
                "content": "Group the first two and last two terms."
              },
              {
                "type": "text",
                "content": "Factor each group."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(1-3y)(y-4)",
            "showAt": 40,
            "spItems": [
              {
                "type": "text",
                "content": "Take the common factor (y−4)."
              },
              {
                "type": "text",
                "content": "This is the complete factorization."
              }
            ]
          }
        ]
      }
