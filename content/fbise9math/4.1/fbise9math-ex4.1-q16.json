    "audio": "music.mp3",
    "theme": "blue",
    "background": {
      "backgroundColor": "#010214",
      "backgroundImage": "banner.webp",
      "backgroundImageOpacity": 0.09
    },
    "deck": [
      {
        "type": "eq",
        "start": 0,
        "end": 80,
        "data": [
          {
            "name": "line",
            "type": "heading",
            "content": "Exercise 4.1 — Question 16",
            "showAt": 0,
            "spItems": [
              {
                "type": "text",
                "content": "Factorize the following expression."
              },
              {
                "type": "text",
                "content": "First take out the common factor 4."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "4x^4+256y^4",
            "showAt": 10,
            "spItems": [
              {
                "type": "text",
                "content": "Take 4 common from both terms."
              },
              {
                "type": "text",
                "content": "This leaves x⁴+64y⁴."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "4(x^4+64y^4)",
            "showAt": 20,
            "spItems": [
              {
                "type": "text",
                "content": "Rewrite 64y⁴ as (8y²)²."
              },
              {
                "type": "text",
                "content": "Complete the square using 8xy²."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "4((x^2+8y^2)^2-16x^2y^2)",
            "showAt": 30,
            "spItems": [
              {
                "type": "text",
                "content": "Add and subtract 16x²y²."
              },
              {
                "type": "text",
                "content": "This creates a difference of two squares."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "4((x^2+8y^2)^2-(4xy)^2)",
            "showAt": 40,
            "spItems": [
              {
                "type": "text",
                "content": "Write 16x²y² as (4xy)²."
              },
              {
                "type": "text",
                "content": "Apply A²−B²=(A−B)(A+B)."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "4(x^2-4xy+8y^2)(x^2+4xy+8y^2)",
            "showAt": 50,
            "spItems": [
              {
                "type": "text",
                "content": "Substitute A=x²+8y² and B=4xy."
              },
              {
                "type": "text",
                "content": "This is the complete factorization."
              }
            ]
          }
        ]
      }
    ]
  }
}