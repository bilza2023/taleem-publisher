            "showAt": 10,
            "spItems": [
              {
                "type": "text",
                "content": "Multiply 3 by 6 to get 18."
              },
              {
                "type": "text",
                "content": "Find factors of 18 whose sum is 11."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "3x^2+9x+2x+6",
            "showAt": 20,
            "spItems": [
              {
                "type": "text",
                "content": "The required factors are 9 and 2."
              },
              {
                "type": "text",
                "content": "Split 11x into 9x+2x."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "3x(x+3)+2(x+3)",
            "showAt": 30,
            "spItems": [
              {
                "type": "text",
                "content": "Group the first two and last two terms."
              },
              {
                "type": "text",
                "content": "Factor each group."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(3x+2)(x+3)",
            "showAt": 40,
            "spItems": [
              {
                "type": "text",
                "content": "Take the common factor (x+3)."
              },
