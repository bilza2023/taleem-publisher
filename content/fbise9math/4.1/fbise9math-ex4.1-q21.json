            "type": "heading",
            "content": "Exercise 4.1 — Question 21",
            "showAt": 0,
            "spItems": [
              {
                "type": "text",
                "content": "Factorize the following expression."
              },
              {
                "type": "text",
                "content": "Find two numbers whose product is 90 and sum is −21."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "x^2-21x+90",
            "showAt": 10,
            "spItems": [
              {
                "type": "text",
                "content": "The leading coefficient is 1."
              },
              {
                "type": "text",
                "content": "Look for factors of 90 that add to −21."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "x^2-6x-15x+90",
            "showAt": 20,
            "spItems": [
              {
                "type": "text",
                "content": "The required numbers are −6 and −15."
              },
              {
                "type": "text",
                "content": "Split −21x into −6x−15x."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "x(x-6)-15(x-6)",
            "showAt": 30,
            "spItems": [
              {
                "type": "text",
                "content": "Group the first two and last two terms."
              },
              {
                "type": "text",
                "content": "Factor x from the first group and −15 from the second."
              }
            ]
          },
          {
            "name": "line",
            "type": "math",
            "content": "(x-6)(x-15)",
            "showAt": 40,
            "spItems": [
              {
                "type": "text",
                "content": "Take the common factor (x−6)."
              },
              {
                "type": "text",
                "content": "This is the complete factorization."
              }
            ]
          }
        ]
      }
