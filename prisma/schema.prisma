generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ContentType {
  ARTICLE
  PLAYER
  MCQ
}

enum CourseAccess {
  OPEN
  MEMBERS
  SUBSCRIPTION
}

model Course {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  title       String
  description String?
  thumbnail   String?

  access      CourseAccess @default(OPEN)
  price       Int @default(0)

  groupings   String @default("[]")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("student")
  resource  String?
  createdAt DateTime @default(now())

  subscriptions  Subscription[]
  communications Communication[]
}

model Admin {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  courseSlug String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Library {
  slug               String @id
  title              String
  description        String?
  thumbnail          String?
  type               ContentType
  body               String?
  courseSlug         String
  groupSlug          String
  sortOrder          Int @default(0)
  allowCommunication Boolean @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
model Subscription {
  id Int @id @default(autoincrement())

  userId     Int
  courseSlug String

  startsAt DateTime @default(now())
  endsAt   DateTime?
  amount Int?
  user User @relation(fields: [userId], references: [id])

  cancelledAt DateTime?

  @@index([userId])
  @@index([courseSlug])
}

model Communication {
  id Int @id @default(autoincrement())

  userId    Int
  librarySlug String

  type String
  meta String?
  message String
  authorResponse String?

  isPublic Boolean @default(false)
  readAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([librarySlug])
}
